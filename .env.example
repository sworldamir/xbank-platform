# Local development configuration. Never commit your real .env file.
NODE_ENV=development
PORT=4000
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_ALPHANUMERIC_PASSWORD
DATABASE_URL=postgresql://xbank:CHANGE_TO_A_LONG_RANDOM_ALPHANUMERIC_PASSWORD@localhost:5432/xbank
DB_POOL_MAX=10
DATABASE_SSL=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000

# All financial products remain disabled by default.
FINANCIAL_OPERATIONS_ENABLED=false
LEGAL_COMPLIANCE_APPROVAL_ID=
EMAIL_VERIFICATION_REQUIRED=true
PUBLIC_BASE_URL=http://localhost:5173

# Configure SMTP before production registration and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Production-only override. Keep false unless a formal adjustment policy exists.
ALLOW_MANUAL_LEDGER_ADJUSTMENTS=false
